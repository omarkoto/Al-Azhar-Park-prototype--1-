# ─────────────────────────────────────────────────────────────────────────────
# Al-Azhar Park API — environment variables
# Copy to backend/.env and adjust. NEVER commit the real .env file.
# Every variable is validated at start-up (src/config/env.schema.ts):
# the server refuses to boot if something required is missing or malformed.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development            # development | test | production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent

# ── Database (PostgreSQL) — see docs/postgres-setup.md ───────────────────────
DATABASE_URL="postgresql://azharpark_app:azharpark_dev_pw_CHANGE_ME@localhost:5432/azharpark?schema=public"
# Used only by automated tests (its data is wiped). Must be a DIFFERENT database.
TEST_DATABASE_URL="postgresql://azharpark_app:azharpark_dev_pw_CHANGE_ME@localhost:5432/azharpark_test?schema=public"

# ── HTTP / security ──────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API (CORS).
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"
# Set to the number of reverse proxies in front of the API (0 = none) so client IPs are correct.
TRUST_PROXY=0
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
# Swagger UI at /api/docs. Keep false in production unless you protect it.
SWAGGER_ENABLED=true

# ── Secrets (required in production; outside production a labelled dev-only value is used if empty) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
TICKET_TOKEN_PEPPER=

# ── Payments ─────────────────────────────────────────────────────────────────
# PAYMENT_PROVIDER=mock   (development only: a fake "pay" button. Production uses 'none' until a real provider is added.)

# SCAN_RATE_LIMIT_PER_MINUTE=300   (gate scans per minute per address; separate from the general limit)

# ── E-mail and tickets ───────────────────────────────────────────────────────
# EMAIL_PROVIDER=log      (development: writes e-mails to the log. Production: smtp, with the two lines below)
# EMAIL_SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM="Al-Azhar Park <tickets@example.com>"
# PUBLIC_SITE_URL=https://www.azharpark.com
# Rotating QR signing keys (optional; default is key 1 = TICKET_TOKEN_PEPPER):
# TICKET_QR_KEYS={"1":"<32+ chars>","2":"<32+ chars>"}
# TICKET_QR_ACTIVE_KEY_ID=2

# ── Uploaded media ───────────────────────────────────────────────────────────
# MEDIA_DIR=./storage/media        (git-ignored; mount a persistent volume in production)
# MEDIA_MAX_IMAGE_MB=8
# MEDIA_MAX_PDF_MB=15

# ── Authentication (defaults shown) ──────────────────────────────────────────
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7
# SESSION_MAX_DAYS=30
# PASSWORD_RESET_TTL_MINUTES=30
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15

# ── Development seed (prisma/seed.ts) ────────────────────────────────────────
# Password given to the seeded DEVELOPMENT users. Never use a real password; seeding is refused in production.
SEED_DEV_PASSWORD="ChangeMe-Dev-2026!"
