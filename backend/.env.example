# ─────────────────────────────────────────────────────────────────────────────
# Al-Azhar Park API — environment variables
# Copy to backend/.env and adjust. NEVER commit the real .env file.
# Every variable is validated at start-up (src/config/env.schema.ts):
# the server refuses to boot if something required is missing or malformed.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development            # development | test | production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent

# ── Database (PostgreSQL) — see docs/postgres-setup.md ───────────────────────
DATABASE_URL="postgresql://azharpark_app:azharpark_dev_pw_CHANGE_ME@localhost:5432/azharpark?schema=public"
# Used only by automated tests (its data is wiped). Must be a DIFFERENT database.
TEST_DATABASE_URL="postgresql://azharpark_app:azharpark_dev_pw_CHANGE_ME@localhost:5432/azharpark_test?schema=public"

# ── HTTP / security ──────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API (CORS).
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"
# Set to the number of reverse proxies in front of the API (0 = none) so client IPs are correct.
TRUST_PROXY=0
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
# Swagger UI at /api/docs. Keep false in production unless you protect it.
SWAGGER_ENABLED=true

# ── Secrets (Phase 2+; required in production, auto-generated placeholders are NOT used) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
TICKET_TOKEN_PEPPER=

# ── Development seed (prisma/seed.ts) ────────────────────────────────────────
# Password given to the seeded DEVELOPMENT users. Never use a real password; seeding is refused in production.
SEED_DEV_PASSWORD="ChangeMe-Dev-2026!"
