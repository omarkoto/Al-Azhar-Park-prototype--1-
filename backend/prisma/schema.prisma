// Al-Azhar Park — database schema (PostgreSQL)
//
// Conventions
//  • Internal ids are UUIDs (never shown to customers). Customer-facing references are separate
//    human-friendly columns: orders.order_number (AZP-2026-000123) and tickets.public_ref (TKT-8F3K2L…).
//  • Money is stored as integer minor units (piastres): 50 EGP = 5000. Never floats.
//  • Dates the visitor chooses (visit_date, price validity, special hours) are `date` in Africa/Cairo.
//  • Instants are timestamptz. Tables map to snake_case.
//  • Financial / entry history is never deleted: orders, order_items, payments, tickets, ticket_scans
//    and audit_logs are protected by database triggers (see migration `20261004000100_integrity_rules`).
//  • Some rules Prisma cannot express (exclusion constraint on prices, CHECK constraints, triggers) live in
//    the raw SQL part of the migrations — they are part of the schema contract and are covered by tests.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, btree_gist]
}

// ─────────────────────────────── enums ───────────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  EXPIRED
  REFUNDED

  @@map("order_status")
}

enum OrderChannel {
  ONLINE
  COUNTER_SALE

  @@map("order_channel")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED

  @@map("payment_status")
}

enum PaymentMethod {
  ONLINE
  CASH

  @@map("payment_method")
}

enum TicketStatus {
  PENDING
  VALID
  USED
  CANCELLED
  EXPIRED
  REFUNDED

  @@map("ticket_status")
}

enum ScanResult {
  VALID
  INVALID

  @@map("scan_result")
}

enum ScanReason {
  OK
  NOT_FOUND
  ALREADY_USED
  CANCELLED
  REFUNDED
  EXPIRED
  WRONG_DATE
  NOT_PAID
  INVALID_TOKEN

  @@map("scan_reason")
}

enum PriceKind {
  STANDARD
  SPECIAL
  PROMOTIONAL

  @@map("price_kind")
}

enum SpecialHoursKind {
  HOLIDAY
  TEMPORARY_CLOSURE
  SPECIAL_HOURS

  @@map("special_hours_kind")
}

/// DRAFT: portal only. COMING_SOON / PUBLISHED: public. CANCELLED / ARCHIVED: hidden from the public.
enum EventStatus {
  DRAFT
  COMING_SOON
  PUBLISHED
  CANCELLED
  ARCHIVED

  @@map("event_status")
}

enum DataRequestType {
  ACCESS
  DELETION
  ANONYMIZATION

  @@map("data_request_type")
}

enum DataRequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  REJECTED

  @@map("data_request_status")
}

enum NotificationChannel {
  EMAIL
  SMS

  @@map("notification_channel")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED

  @@map("notification_status")
}

enum RequestStatus {
  NEW
  CONFIRMED
  DECLINED
  CANCELLED

  @@map("request_status")
}

// ───────────────────── identity, roles & permissions ─────────────────────

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String    @unique @db.Citext
  passwordHash      String    @map("password_hash")
  fullName          String    @map("full_name")
  isActive          Boolean   @default(true) @map("is_active")
  /// bumped on password change / deactivation so already-issued access tokens stop working
  tokenVersion      Int       @default(0) @map("token_version")
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles               UserRole[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  scans               TicketScan[]
  usedTickets         Ticket[]             @relation("TicketUsedBy")
  createdPrices       TicketPrice[]
  createdOrders       Order[]              @relation("OrderCreatedBy")
  recordedPayments    Payment[]            @relation("PaymentRecordedBy")
  uploadedMedia       Media[]
  handledDataRequests DataRequest[]
  handledMessages     ContactMessage[]
  handledReservations ReservationRequest[]

  @@map("users")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name        String
  description String?
  /// system roles cannot be deleted from the portal
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// `resource:action`, e.g. `tickets:read`, `scans:create`, `pricing:write`
  code        String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  /// all tokens descended from one login share a family; reuse of a rotated token revokes the family
  familyId         String    @map("family_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  /// when the login (first token of the family) happened; every rotated token inherits it, so a session has an absolute maximum age
  sessionStartedAt DateTime  @default(now()) @map("session_started_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  ip               String?
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt], map: "ix_refresh_tokens_expires_at")
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt], map: "ix_password_reset_tokens_expires_at")
  @@map("password_reset_tokens")
}

// ─────────────────────────── customers & privacy ───────────────────────────

/// Guest customers: only what is needed to deliver a ticket. No passwords, no nationality documents.
model Customer {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName             String    @map("full_name")
  email                String?   @db.Citext
  phone                String?
  country              String?
  /// which privacy notice the customer accepted and when (text itself is managed outside the code)
  privacyNoticeVersion String?   @map("privacy_notice_version")
  consentedAt          DateTime? @map("consented_at") @db.Timestamptz(3)
  /// set when personal fields were irreversibly blanked; the row (and orders/tickets) stay for accounting
  anonymizedAt         DateTime? @map("anonymized_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders       Order[]
  tickets      Ticket[]
  dataRequests DataRequest[]

  @@index([email])
  @@index([phone])
  @@map("customers")
}

/// Access / deletion / anonymisation requests, so every privacy action is traceable.
model DataRequest {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String?           @map("customer_id") @db.Uuid
  type        DataRequestType
  status      DataRequestStatus @default(OPEN)
  requestedAt DateTime          @default(now()) @map("requested_at") @db.Timestamptz(3)
  completedAt DateTime?         @map("completed_at") @db.Timestamptz(3)
  handledById String?           @map("handled_by_id") @db.Uuid
  notes       String?

  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  handledBy User?     @relation(fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("data_requests")
}

// ───────────────────── ticket configuration & pricing ─────────────────────

/// Who is buying: RESIDENT (Egyptian / resident), VISITOR (non-resident). New audiences = new rows.
model TicketAudience {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String   @unique
  nameEn        String   @map("name_en")
  nameAr        String   @map("name_ar")
  descriptionEn String?  @map("description_en")
  descriptionAr String?  @map("description_ar")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  prices     TicketPrice[]
  orderItems OrderItem[]
  tickets    Ticket[]

  @@map("ticket_audiences")
}

/// What is being bought: ADULT, CHILD (2–8) … new products = new rows.
model TicketType {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String    @unique
  nameEn        String    @map("name_en")
  nameAr        String    @map("name_ar")
  descriptionEn String?   @map("description_en")
  descriptionAr String?   @map("description_ar")
  /// children under 2 do not need a ticket, so no ticket type may start below 2 (enforced by a CHECK)
  minAge        Int       @default(2) @map("min_age")
  maxAge        Int?      @map("max_age")
  isActive      Boolean   @default(true) @map("is_active")
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  prices     TicketPrice[]
  orderItems OrderItem[]
  tickets    Ticket[]

  @@map("ticket_types")
}

/// One row = "this type, for this audience, on these days, between these dates, costs this much".
///
/// The normal matrix (weekday / weekend) is STANDARD rows with different `dow_mask`.
/// Special days, holidays and promotions are extra rows that win by `priority`:
///   • SPECIAL      → `special_dates` set (holidays, Eid …), higher priority than STANDARD
///   • PROMOTIONAL  → optional `promo_code`, highest priority
/// Rows are append-only history: to change a price, close the old row (`valid_to`) and insert a new one.
/// Orders copy the price they used, so editing/adding rows can never alter a past order.
model TicketPrice {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketTypeId String     @map("ticket_type_id") @db.Uuid
  audienceId   String     @map("audience_id") @db.Uuid
  kind         PriceKind  @default(STANDARD)
  nameEn       String?    @map("name_en")
  nameAr       String?    @map("name_ar")
  amountMinor  Int        @map("amount_minor")
  currency     String     @default("EGP") @db.Char(3)
  /// higher wins when several rows match a date (STANDARD 0, SPECIAL 10, PROMOTIONAL 20 by convention)
  priority     Int        @default(0)
  /// weekdays the row applies to, as a bit mask: Sun=1, Mon=2, Tue=4, Wed=8, Thu=16, Fri=32, Sat=64.
  /// weekday (Sun–Thu) = 31, weekend (Fri–Sat) = 96, every day = 127.
  dowMask      Int        @default(127) @map("dow_mask") @db.SmallInt
  /// when non-empty the row applies ONLY on these dates (holiday pricing)
  specialDates DateTime[] @default([]) @map("special_dates") @db.Date
  promoCode    String?    @map("promo_code")
  validFrom    DateTime   @map("valid_from") @db.Date
  /// null = open ended
  validTo      DateTime?  @map("valid_to") @db.Date
  isActive     Boolean    @default(true) @map("is_active")
  notes        String?
  createdById  String?    @map("created_by_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  ticketType TicketType     @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  audience   TicketAudience @relation(fields: [audienceId], references: [id], onDelete: Restrict)
  createdBy  User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@index([ticketTypeId, audienceId, validFrom])
  @@index([validFrom, validTo])
  @@map("ticket_prices")
}

model Gate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  scans TicketScan[]

  @@map("gates")
}

// ───────────────────────── orders, payments, tickets ─────────────────────────

model Order {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// customer-facing, e.g. AZP-2026-000123
  orderNumber    String       @unique @map("order_number")
  customerId     String?      @map("customer_id") @db.Uuid
  channel        OrderChannel
  status         OrderStatus  @default(PENDING_PAYMENT)
  visitDate      DateTime     @map("visit_date") @db.Date
  subtotalMinor  Int          @map("subtotal_minor")
  discountMinor  Int          @default(0) @map("discount_minor")
  totalMinor     Int          @map("total_minor")
  currency       String       @default("EGP") @db.Char(3)
  promoCode      String?      @map("promo_code")
  /// client-supplied key so a retried request cannot create a second order
  idempotencyKey String?      @unique @map("idempotency_key")
  /// unpaid online orders expire (their tickets become EXPIRED)
  expiresAt      DateTime?    @map("expires_at") @db.Timestamptz(3)
  paidAt         DateTime?    @map("paid_at") @db.Timestamptz(3)
  cancelledAt    DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  /// an operational reason is mandatory when an order is cancelled. Cancelling is NOT a refund (there are no refunds).
  cancelReason   String?      @map("cancel_reason")
  /// staff member who created a COUNTER_SALE order
  createdById    String?      @map("created_by_id") @db.Uuid
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer     Customer?          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy    User?              @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items        OrderItem[]
  payments     Payment[]
  tickets      Ticket[]
  accessTokens OrderAccessToken[]

  @@index([customerId])
  @@index([visitDate])
  @@index([status, createdAt])
  @@index([channel, createdAt])
  @@index([createdAt])
  @@map("orders")
}

/// Secure, expiring access for guest customers (magic links). Only a hash is stored.
model OrderAccessToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String    @map("order_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_access_tokens")
}

/// Snapshot of what was sold. The price columns are written once and never updated.
model OrderItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  ticketTypeId   String   @map("ticket_type_id") @db.Uuid
  audienceId     String   @map("audience_id") @db.Uuid
  /// which price row was applied (for traceability; the amount below is authoritative)
  ticketPriceId  String   @map("ticket_price_id") @db.Uuid
  typeNameEn     String   @map("type_name_en")
  typeNameAr     String   @map("type_name_ar")
  audienceNameEn String   @map("audience_name_en")
  audienceNameAr String   @map("audience_name_ar")
  unitPriceMinor Int      @map("unit_price_minor")
  currency       String   @default("EGP") @db.Char(3)
  quantity       Int
  lineTotalMinor Int      @map("line_total_minor")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order      Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  ticketType TicketType     @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  audience   TicketAudience @relation(fields: [audienceId], references: [id], onDelete: Restrict)
  price      TicketPrice    @relation(fields: [ticketPriceId], references: [id], onDelete: Restrict)
  tickets    Ticket[]

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String        @map("order_id") @db.Uuid
  /// MANUAL (counter / staff) or an online gateway code such as PAYMOB
  provider      String
  method        PaymentMethod
  providerTxnId String?       @map("provider_txn_id")
  amountMinor   Int           @map("amount_minor")
  currency      String        @default("EGP") @db.Char(3)
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?     @map("paid_at") @db.Timestamptz(3)
  /// staff member who recorded a manual (cash) payment
  recordedById  String?       @map("recorded_by_id") @db.Uuid
  metadata      Json?
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order      Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  recordedBy User? @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([provider, providerTxnId])
  @@index([orderId])
  @@index([status, createdAt])
  @@map("payments")
}

model Ticket {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// customer-facing, unguessable (random, >= 50 bits), e.g. TKT-8F3K2LQ7ZP — NOT the database id
  publicRef      String       @unique @map("public_ref")
  orderId        String       @map("order_id") @db.Uuid
  orderItemId    String       @map("order_item_id") @db.Uuid
  customerId     String?      @map("customer_id") @db.Uuid
  ticketTypeId   String       @map("ticket_type_id") @db.Uuid
  audienceId     String       @map("audience_id") @db.Uuid
  visitDate      DateTime     @map("visit_date") @db.Date
  /// the exact price paid for THIS ticket; never changes
  pricePaidMinor Int          @map("price_paid_minor")
  currency       String       @default("EGP") @db.Char(3)
  holderName     String?      @map("holder_name")
  status         TicketStatus @default(PENDING)
  /// Which signing key produced this ticket's QR (allows key rotation). The QR payload is
  /// AZP1.<public_ref>.<HMAC(key, public_ref)> and is re-derivable from the ref; no secret is stored here.
  qrKeyId        Int          @default(1) @map("qr_key_id") @db.SmallInt
  issuedAt       DateTime?    @map("issued_at") @db.Timestamptz(3)
  usedAt         DateTime?    @map("used_at") @db.Timestamptz(3)
  usedById       String?      @map("used_by_id") @db.Uuid
  cancelledAt    DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  cancelReason   String?      @map("cancel_reason")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  order      Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem  OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  customer   Customer?      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  ticketType TicketType     @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  audience   TicketAudience @relation(fields: [audienceId], references: [id], onDelete: Restrict)
  usedBy     User?          @relation("TicketUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  scans      TicketScan[]

  @@index([visitDate, status])
  @@index([status])
  @@index([orderId])
  @@index([customerId])
  @@map("tickets")
}

/// Every scan attempt, valid or not. `ticket_id` is null when the token matched nothing.
model TicketScan {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId         String?    @map("ticket_id") @db.Uuid
  /// first characters of the token hash, enough to correlate attempts without storing the token
  tokenFingerprint String?    @map("token_fingerprint")
  scannedById      String     @map("scanned_by_id") @db.Uuid
  gateId           String?    @map("gate_id") @db.Uuid
  result           ScanResult
  reason           ScanReason
  scannedAt        DateTime   @default(now()) @map("scanned_at") @db.Timestamptz(3)
  device           Json?
  ip               String?

  ticket    Ticket? @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  scannedBy User    @relation(fields: [scannedById], references: [id], onDelete: Restrict)
  gate      Gate?   @relation(fields: [gateId], references: [id], onDelete: SetNull)

  @@index([scannedAt])
  @@index([ticketId])
  @@index([scannedById, scannedAt])
  @@index([gateId, scannedAt])
  @@index([result, reason])
  @@map("ticket_scans")
}

/// Atomic per-year sequence for human order numbers (AZP-2026-000123).
model ReferenceCounter {
  kind      String
  year      Int
  lastValue Int    @default(0) @map("last_value")

  @@id([kind, year])
  @@map("reference_counters")
}

// ───────────────────────────── park content (CMS) ─────────────────────────────

/// Single row (id = 1).
model ParkSettings {
  id            Int      @id @default(1)
  nameEn        String   @map("name_en")
  nameAr        String   @map("name_ar")
  taglineEn     String?  @map("tagline_en")
  taglineAr     String?  @map("tagline_ar")
  descriptionEn String?  @map("description_en")
  descriptionAr String?  @map("description_ar")
  /// e.g. [{ "value": "72", "labelEn": "...", "labelAr": "..." }]
  stats         Json     @default("[]")
  visitorInfo   Json     @default("{}") @map("visitor_info")
  updatedById   String?  @map("updated_by_id") @db.Uuid
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("park_settings")
}

/// Single row (id = 1).
model ContactInformation {
  id          Int      @id @default(1)
  addressEn   String   @map("address_en")
  addressAr   String   @map("address_ar")
  phones      String[] @default([])
  fax         String?
  email       String?
  mapsUrl     String?  @map("maps_url")
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  socialLinks Json     @default("{}") @map("social_links")
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("contact_information")
}

/// Regular weekly hours: one row per weekday (0 = Sunday … 6 = Saturday). Hours may differ per day.
model OpeningHour {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dayOfWeek Int       @unique @map("day_of_week") @db.SmallInt
  opens     DateTime? @db.Time(0)
  closes    DateTime? @db.Time(0)
  isClosed  Boolean   @default(false) @map("is_closed")
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("opening_hours")
}

/// Exceptions that override the weekly hours for a date range: holidays, Ramadan, closures, events.
/// If several overlap a date, the highest `priority` (then the newest) wins.
model SpecialHours {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind      SpecialHoursKind
  dateFrom  DateTime         @map("date_from") @db.Date
  dateTo    DateTime         @map("date_to") @db.Date
  opens     DateTime?        @db.Time(0)
  closes    DateTime?        @db.Time(0)
  isClosed  Boolean          @default(false) @map("is_closed")
  labelEn   String           @map("label_en")
  labelAr   String           @map("label_ar")
  noteEn    String?          @map("note_en")
  noteAr    String?          @map("note_ar")
  priority  Int              @default(0)
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([dateFrom, dateTo])
  @@map("special_hours")
}

model Venue {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String    @unique
  nameEn        String    @map("name_en")
  nameAr        String    @map("name_ar")
  descriptionEn String?   @map("description_en")
  descriptionAr String?   @map("description_ar")
  capacity      Int?
  areaSqm       Int?      @map("area_sqm")
  latitude      Decimal?  @db.Decimal(9, 6)
  longitude     Decimal?  @db.Decimal(9, 6)
  addressEn     String?   @map("address_en")
  addressAr     String?   @map("address_ar")
  /// inactive venues cannot be chosen for new events; events that already use one keep it
  isActive      Boolean   @default(true) @map("is_active")
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  events Event[]

  @@map("venues")
}

model Event {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug               String      @unique
  titleEn            String      @map("title_en")
  titleAr            String      @map("title_ar")
  shortDescriptionEn String      @map("short_description_en")
  shortDescriptionAr String      @map("short_description_ar")
  descriptionEn      String      @map("description_en")
  descriptionAr      String      @map("description_ar")
  heroMediaId        String?     @map("hero_media_id") @db.Uuid
  status             EventStatus @default(DRAFT)
  isFeatured         Boolean     @default(false) @map("is_featured")
  sortOrder          Int         @default(0) @map("sort_order")
  startsAt           DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime?   @map("ends_at") @db.Timestamptz(3)
  /// optional human wording shown instead of a computed date, e.g. "Dates to be confirmed"
  dateLabelEn        String?     @map("date_label_en")
  dateLabelAr        String?     @map("date_label_ar")
  timeLabelEn        String?     @map("time_label_en")
  timeLabelAr        String?     @map("time_label_ar")
  venueId            String?     @map("venue_id") @db.Uuid
  locationNameEn     String?     @map("location_name_en")
  locationNameAr     String?     @map("location_name_ar")
  publishedAt        DateTime?   @map("published_at") @db.Timestamptz(3)
  createdById        String?     @map("created_by_id") @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?   @map("deleted_at") @db.Timestamptz(3)

  venue     Venue?       @relation(fields: [venueId], references: [id], onDelete: SetNull)
  heroMedia Media?       @relation("EventHero", fields: [heroMediaId], references: [id], onDelete: SetNull)
  gallery   EventMedia[]

  @@index([status, startsAt])
  @@index([startsAt])
  @@index([status, sortOrder], map: "ix_events_status_sort")
  @@map("events")
}

model EventMedia {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String  @map("event_id") @db.Uuid
  mediaId   String  @map("media_id") @db.Uuid
  sortOrder Int     @default(0) @map("sort_order")
  captionEn String? @map("caption_en")
  captionAr String? @map("caption_ar")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([eventId, mediaId])
  @@map("event_media")
}

model Restaurant {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug               String    @unique
  nameEn             String    @map("name_en")
  nameAr             String    @map("name_ar")
  brandEn            String?   @map("brand_en")
  brandAr            String?   @map("brand_ar")
  taglineEn          String?   @map("tagline_en")
  taglineAr          String?   @map("tagline_ar")
  shortDescriptionEn String?   @map("short_description_en")
  shortDescriptionAr String?   @map("short_description_ar")
  descriptionEn      String    @map("description_en")
  descriptionAr      String    @map("description_ar")
  atmosphereEn       String?   @map("atmosphere_en")
  atmosphereAr       String?   @map("atmosphere_ar")
  locationEn         String?   @map("location_en")
  locationAr         String?   @map("location_ar")
  opensAt            DateTime? @map("opens_at") @db.Time(0)
  closesAt           DateTime? @map("closes_at") @db.Time(0)
  phones             String[]  @default([])
  reservationUrl     String?   @map("reservation_url")
  websiteUrl         String?   @map("website_url")
  instagramUrl       String?   @map("instagram_url")
  heroMediaId        String?   @map("hero_media_id") @db.Uuid
  isActive           Boolean   @default(true) @map("is_active")
  sortOrder          Int       @default(0) @map("sort_order")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)

  heroMedia    Media?               @relation("RestaurantHero", fields: [heroMediaId], references: [id], onDelete: SetNull)
  gallery      RestaurantMedia[]
  menus        Menu[]
  reservations ReservationRequest[]

  @@index([isActive, sortOrder])
  @@map("restaurants")
}

model RestaurantMedia {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String  @map("restaurant_id") @db.Uuid
  mediaId      String  @map("media_id") @db.Uuid
  sortOrder    Int     @default(0) @map("sort_order")
  captionEn    String? @map("caption_en")
  captionAr    String? @map("caption_ar")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  media      Media      @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([restaurantId, mediaId])
  @@map("restaurant_media")
}

/// A restaurant can have several menus. Today's menus are external PDFs (`externalUrl`); later they can be
/// structured (categories + items) or an uploaded PDF (`pdfMediaId`).
model Menu {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  nameEn       String    @map("name_en")
  nameAr       String    @map("name_ar")
  externalUrl  String?   @map("external_url")
  pdfMediaId   String?   @map("pdf_media_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  pdfMedia   Media?         @relation("MenuPdf", fields: [pdfMediaId], references: [id], onDelete: SetNull)
  categories MenuCategory[]

  @@index([restaurantId, sortOrder])
  @@map("menus")
}

model MenuCategory {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menuId    String    @map("menu_id") @db.Uuid
  nameEn    String    @map("name_en")
  nameAr    String    @map("name_ar")
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  menu  Menu       @relation(fields: [menuId], references: [id], onDelete: Restrict)
  items MenuItem[]

  @@index([menuId, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId    String    @map("category_id") @db.Uuid
  nameEn        String    @map("name_en")
  nameAr        String    @map("name_ar")
  descriptionEn String?   @map("description_en")
  descriptionAr String?   @map("description_ar")
  priceMinor    Int       @map("price_minor")
  currency      String    @default("EGP") @db.Char(3)
  mediaId       String?   @map("media_id") @db.Uuid
  isAvailable   Boolean   @default(true) @map("is_available")
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  media    Media?       @relation("MenuItemImage", fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([categoryId, sortOrder])
  @@map("menu_items")
}

/// File metadata only. Binary data lives in the storage provider (local disk / S3 / R2 / Cloudinary).
model Media {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider     String    @default("local")
  storageKey   String    @unique @map("storage_key")
  url          String
  fileName     String    @map("file_name")
  mimeType     String    @map("mime_type")
  sizeBytes    Int       @map("size_bytes")
  width        Int?
  height       Int?
  altEn        String?   @map("alt_en")
  altAr        String?   @map("alt_ar")
  uploadedById String?   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  uploadedBy        User?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  eventHero         Event[]           @relation("EventHero")
  eventGallery      EventMedia[]
  restaurantHero    Restaurant[]      @relation("RestaurantHero")
  restaurantGallery RestaurantMedia[]
  menuPdfs          Menu[]            @relation("MenuPdf")
  menuItemImages    MenuItem[]        @relation("MenuItemImage")

  @@map("media")
}

// ───────────────────────── operations, audit & settings ─────────────────────────

/// Messages from the website contact form.
model ContactMessage {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  email                String    @db.Citext
  phone                String?
  message              String
  locale               String    @default("en")
  privacyNoticeVersion String?   @map("privacy_notice_version")
  handledById          String?   @map("handled_by_id") @db.Uuid
  handledAt            DateTime? @map("handled_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  handledBy User? @relation(fields: [handledById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("contact_messages")
}

/// Table-reservation requests from the restaurant pages (staff confirm by phone/email).
model ReservationRequest {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId  String        @map("restaurant_id") @db.Uuid
  name          String
  email         String        @db.Citext
  phone         String?
  partySize     Int           @map("party_size")
  visitDate     DateTime?     @map("visit_date") @db.Date
  preferredTime DateTime?     @map("preferred_time") @db.Time(0)
  notes         String?
  status        RequestStatus @default(NEW)
  handledById   String?       @map("handled_by_id") @db.Uuid
  handledAt     DateTime?     @map("handled_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  handledBy  User?      @relation(fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("reservation_requests")
}

/// Outbox for email/SMS so delivery can be retried and audited independently of the request.
model Notification {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channel        NotificationChannel
  template       String
  recipient      String
  payload        Json
  status         NotificationStatus  @default(PENDING)
  attempts       Int                 @default(0)
  lastError      String?             @map("last_error")
  sentAt         DateTime?           @map("sent_at") @db.Timestamptz(3)
  relatedOrderId String?             @map("related_order_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("notifications")
}

/// Append-only. Updates and deletes are rejected by a database trigger.
model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ip        String?
  userAgent String?  @map("user_agent")
  requestId String?  @map("request_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Typed-by-convention key/value settings (booking window, order expiry minutes, daily capacity …).
model SystemSetting {
  key         String   @id
  value       Json
  description String?
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}
