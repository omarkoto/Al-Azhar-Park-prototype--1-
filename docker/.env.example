# Copy to docker/.env (which is git-ignored) and change every password.

POSTGRES_USER=azharpark_app
POSTGRES_PASSWORD=azharpark_dev_pw_CHANGE_ME
POSTGRES_DB=azharpark
# Host port. 5433 so it does not collide with a local PostgreSQL service on 5432.
POSTGRES_PUBLISHED_PORT=5433

PGADMIN_DEFAULT_EMAIL=admin@azharpark.test
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin
PGADMIN_PUBLISHED_PORT=5050

# Only used with --profile app
API_PUBLISHED_PORT=3000
API_NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
TICKET_TOKEN_PEPPER=
SWAGGER_ENABLED=true
